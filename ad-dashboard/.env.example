# ── Data source ────────────────────────────────────────────────
# "mock" (default) uses generated demo data. "composio" pulls live data.
DATA_SOURCE=mock

# ── Composio ───────────────────────────────────────────────────
COMPOSIO_API_KEY=
# The Composio user id your ad accounts are connected under.
# (Later, each client portal login maps to its own user id.)
COMPOSIO_USER_ID=default
# Toolkit slugs as shown in your Composio dashboard.
COMPOSIO_GOOGLE_ADS_TOOLKIT=googleads
COMPOSIO_META_ADS_TOOLKIT=facebook

# ── Google Ads ─────────────────────────────────────────────────
# Required by the Google Ads API for every request.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Your manager (MCC) account id, digits only, if you access accounts through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
# Optional comma-separated allowlist of customer ids (digits only).
GOOGLE_ADS_CUSTOMER_IDS=

# ── Meta Ads ───────────────────────────────────────────────────
META_GRAPH_API_VERSION=v23.0
# Meta action types counted as a "lead", in priority order. The first one
# present in a row is used (they overlap, so they are never summed).
META_LEAD_ACTION_TYPES=lead,onsite_conversion.lead_grouped,offsite_conversion.fb_pixel_lead
